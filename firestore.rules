rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Помощники
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Правила для пользователей
    match /users/{userId} {
      allow read: if isSignedIn(); // Защищаем PII пользователей
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId);
    }

    // Правила для объявлений
    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.userId) || request.auth.token.admin == true);
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || request.auth.token.admin == true);
    }

    // Правила для чатов
    match /chats/{chatId} {
      // Разрешаем чтение и создание чата только его участникам
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.users);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.users);
      
      match /messages/{messageId} {
        // Читать сообщения может только участник чата
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        // Писать может только участник чата от своего имени
        allow create: if isSignedIn() 
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users)
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && isOwner(resource.data.senderId);
      }
    }

    // Правила для отзывов
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.fromUserId);
    }
    
    // Правила для жалоб
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if false; // Только админы через консоль
    }
  }
}
