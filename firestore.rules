rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Поддержка как Custom Claims, так и роли в документе
      return (request.auth.token.admin == true) || 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin');
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAny(['accountType']) || request.resource.data.accountType in ['user', 'driver']);
      allow delete: if isOwner(userId);
      // Пользователь может обновить свой профиль, но не может изменить роль/рейтинг
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'rating', 'reviewsCount', 'status'])));

      // Уведомления: любой авторизованный может создать (отправить уведомление другому),
      // но читать и удалять — только сам владелец.
      match /notifications/{notifId} {
        allow create: if isSignedIn() && request.resource.data.keys().hasAll(['title', 'body', 'type', 'timestamp']);
        allow read, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /ads/{adId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.keys().hasAll(['title', 'userId', 'timestamp']);
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /chats/{chatId} {
      function isChatParticipant() {
        return request.auth.uid in resource.data.users;
      }

      allow read, create, update: if isSignedIn() && isChatParticipant();
      allow delete: if false; 
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && isChatParticipant();
        allow create: if isSignedIn() && isChatParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && isChatParticipant() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'rating']);
      allow update, delete: if isSignedIn() && isOwner(resource.data.fromUserId);
    }
    
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if false; 
    }

    // Правила для Telegram Auth Сессий (X10 Security)
    match /tg_auth_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['created_at', 'verified', 'chat_id', 'otp', 'phone', 'customToken']) && request.resource.data.verified == false && request.resource.data.otp == null;
      allow get: if true; 
      allow list: if false; 
      allow update, delete: if false; 
    }

    // Для Driver Verification (хоть такси и отложили, правила должны быть)
    match /driver_verifications/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false; 
    }

    // Настройки приложения (lifecycle, конфигурация)
    // Читать может любой авторизованный пользователь,
    // писать — только администратор (ежемесячная чистка объявлений).
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    // Правила для Такси
    // update разрешён обоим участникам сделки: водитель обновляет статус поездки,
    // пассажир принимает ставку водителя и наоборот — оба пишут в оба документа.
    // delete оставлен только владельцу документа (создателю) и админу.
    match /taxi_rides/{rideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid && request.resource.data.keys().hasAll(['driverId', 'from', 'to', 'status', 'createdAt']);
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.driverId ||
        request.auth.uid == resource.data.passengerId ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );
    }

    match /taxi_orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid && request.resource.data.keys().hasAll(['passengerId', 'from', 'to', 'status', 'createdAt']);
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId ||
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId ||
        isAdmin()
      );
    }

    match /taxi_bids/{bidId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.keys().hasAll(['senderId', 'receiverId', 'targetId', 'price', 'status']);
      allow read, update: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow delete: if false;
    }

    match /taxi_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.keys().hasAll(['authorId', 'rating']);
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
    }
  }
}
