// -------------------------------------------------------------
// AUTO-GENERATED FIRESTORE RULES - DO NOT EDIT THIS FILE DIRECTLY
// EDIT INDIVIDUAL MODULES IN "firestore_rules/" INSTEAD
// GENERATED AT: 2026-08-07T20:34:36.368328Z
// -------------------------------------------------------------

// ==========================================
// MODULE: 00_header.rules
// ==========================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


// ==========================================
// MODULE: 01_helpers.rules
// ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Поддержка как Custom Claims, так и роли в документе
      return request.auth != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin')
      );
    }

    // Забанен ли текущий авторизованный пользователь (users/{uid}.status == 'banned',
    // ставится админом из admin_reports_screen.dart через UserService.toggleUserBan)
    function isBanned() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'banned';
    }

    // Заблокировал ли "другой" участник usersList (ровно 2 uid, как chats.users)
    // текущего пользователя через users/{otherUid}.blockedUserIds (личная блокировка,
    // AppConfigProvider.blockUser)
    function isBlockedByUsersList(usersList) {
      let otherUid = usersList[0] == request.auth.uid ? usersList[1] : usersList[0];
      return exists(/databases/$(database)/documents/users/$(otherUid))
        && get(/databases/$(database)/documents/users/$(otherUid)).data.get('blockedUserIds', []).hasAny([request.auth.uid]);
    }

    // То же самое, но по уже существующему чату chats/{chatId}
    function isBlockedInChat(chatId) {
      let chatUsers = get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      return isBlockedByUsersList(chatUsers);
    }


// ==========================================
// MODULE: 02_users.rules
// ==========================================
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId 
        && !request.resource.data.keys().hasAny(['phone', 'email', 'telegram_chat_id', 'telegramChatId'])
        && (!request.resource.data.keys().hasAny(['accountType']) || request.resource.data.accountType in ['user', 'driver'])
        && (!request.resource.data.keys().hasAny(['isVerified']) || request.resource.data.isVerified == false || (request.auth.uid.size() >= 9 && request.auth.uid[0:9] == 'telegram_'));
      allow delete: if isOwner(userId);
      // Пользователь может обновить свой профиль (в т.ч. driverOnboardingStep в диапазоне 0..3), но не может изменить роль/рейтинг/верификацию/контакты
      allow update: if isAdmin() || (isOwner(userId) 
        && !request.resource.data.keys().hasAny(['phone', 'email', 'telegram_chat_id', 'telegramChatId'])
        && (!request.resource.data.keys().hasAny(['driverOnboardingStep']) || (request.resource.data.driverOnboardingStep is int && request.resource.data.driverOnboardingStep >= 0 && request.resource.data.driverOnboardingStep <= 3))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'rating', 'reviewsCount', 'status', 'isVerified', 'duplicateStrikeCount', 'postingRestricted', 'postingRestrictedAt'])));

      match /private/contact {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow create: if isSignedIn() && (
          isOwner(userId) ||
          isAdmin() ||
          (
            request.resource.data.keys().hasAll(['title', 'body', 'type', 'timestamp', 'senderId']) &&
            request.resource.data.senderId == request.auth.uid &&
            notifId.size() > 5 && 
            notifId[0:5] == 'chat_' && 
            get(/databases/$(database)/documents/chats/$(notifId[5:])).data.users.hasAll([request.auth.uid, userId])
          )
        );
        allow read, delete: if isOwner(userId);
        allow update: if isSignedIn() && (
          isOwner(userId) || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) ||
          (
            // Разрешаем отправителю обновлять chat-notification (upsert паттерн)
            // Те же проверки что и в create — senderId, формат notifId, участие в чате
            request.resource.data.keys().hasAll(['title', 'body', 'type', 'timestamp', 'senderId']) &&
            request.resource.data.senderId == request.auth.uid &&
            notifId.size() > 5 &&
            notifId[0:5] == 'chat_' &&
            get(/databases/$(database)/documents/chats/$(notifId[5:])).data.users.hasAll([request.auth.uid, userId])
          )
        );
      }
    }


// ==========================================
// MODULE: 03_ads.rules
// ==========================================
    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'userId', 'timestamp'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if isSignedIn()
        && (
          isAdmin() || (
            isOwner(resource.data.userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'views', 'favorites'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['active', 'reserved', 'sold', 'archived'])
          )
        );
      allow delete: if isSignedIn()
        && (isOwner(resource.data.userId) || isAdmin());

      match /stats/counters {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /viewLogs/{logId} {
      allow read, write: if false;
    }


// ==========================================
// MODULE: 04_chats.rules
// ==========================================
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin()) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['users']) ||
        request.resource.data.users.toSet() == resource.data.users.toSet()
      );
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && !isBlockedByUsersList(request.resource.data.users);
      allow delete: if false; 
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users || isAdmin());

        // ─── CREATE ────────────────────────────────────────────────────────────
        allow create: if isSignedIn()
          && !isBanned()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
          && !isBlockedInChat(chatId)
          // Системные сообщения ("Предложение принято/отклонено") пишет только
          // сервер — иначе покупателю можно подсунуть фальшивое подтверждение.
          && request.resource.data.type != 'system'
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000)
          && (
            request.resource.data.type != 'offer'
            ||
            (
              request.resource.data.type == 'offer'
              && request.resource.data.offerPrice is number
              && request.resource.data.offerPrice > 0
              && request.resource.data.adId is string
              && request.resource.data.adId.size() > 0
              && request.auth.uid != get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.userId
              && request.resource.data.offerPrice >= get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.price * 0.7
              && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.status == 'active'
            )
          );

        // ─── UPDATE ────────────────────────────────────────────────────────────
        allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users) && (
          // 1. Sender editing own NON-OFFER messages
          (
            request.auth.uid == resource.data.senderId 
            && resource.data.type != 'offer' 
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'timestamp', 'type'])
          ) || 
          // 2. Sender cancelling own PENDING OFFER message (deduplication)
          (
            request.auth.uid == resource.data.senderId
            && resource.data.type == 'offer'
            && resource.data.offerStatus == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerStatus'])
            && request.resource.data.offerStatus == 'cancelled'
          ) ||
          // 3. Only the recipient (not the sender) marking messages as read/delivered
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'isDelivered', 'readAt'])
            && request.auth.uid != resource.data.senderId
          ) ||
          // 4. Получатель оффера (продавец) может ТОЛЬКО отклонить —
          //    переход в 'accepted' с клиента запрещён физически, не только
          //    в UI. Пока respondToOffer не развёрнута (403 по биллингу
          //    проекта, см. functions/offers.js), Accept вообще недоступен:
          //    продавец либо отклоняет, либо договаривается с покупателем в
          //    чате/по звонку. Дозволять 'accepted' здесь означало бы вернуть
          //    ровно ту дыру, из-за которой был прод-баг с ложным "отклонено".
          (
            resource.data.type == 'offer'
            && request.auth.uid != resource.data.senderId
            && resource.data.offerStatus == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerStatus'])
            && request.resource.data.offerStatus == 'rejected'
          )
        );

        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }


// ==========================================
// MODULE: 05_reviews.rules
// ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn() && isOwner(resource.data.fromUserId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromUserId', 'toUserId']));
      allow delete: if isSignedIn() && (isOwner(resource.data.fromUserId) || isAdmin());
    }


// ==========================================
// MODULE: 06_reports.rules
// ==========================================
    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource == null || resource.data.reporterUserId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if (isSignedIn() && (request.resource.data.reporterUserId == request.auth.uid || request.resource.data.userId == request.auth.uid))
        || (!isSignedIn() && (request.resource.data.reporterUserId == 'anonymous' || request.resource.data.userId == 'anonymous'));
      allow update, delete: if isSignedIn() && isAdmin();
    }


// ==========================================
// MODULE: 07_sessions.rules
// ==========================================
    // Правила для Telegram Auth Сессий (X10 Security)
    match /tg_auth_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['created_at', 'verified', 'chat_id', 'otp', 'phone', 'initiatorUid']) && request.resource.data.verified == false && request.resource.data.otp == null;
      allow get: if true; 
      allow list: if false; 
      allow update: if false; 
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.initiatorUid || isAdmin());
    }


// ==========================================
// MODULE: 08_verifications.rules
// ==========================================
    // Для Driver Verification
    match /driver_verifications/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; 
    }


// ==========================================
// MODULE: 08b_fingerprints.rules
// ==========================================
    // Отпечатки текстов объявлений для защиты от дубликатов
    match /textFingerprints/{docId} {
      allow read, write: if false;
    }

    // Отпечатки картинок объявлений для защиты от дубликатов
    match /imageFingerprints/{docId} {
      allow read, write: if false;
    }

    // Связка userId <-> installId (устройство) для эвристики мульти-аккаунтинга.
    // Пишется и читается только из Cloud Functions через Admin SDK.
    match /userInstallLinks/{docId} {
      allow read, write: if false;
    }


// ==========================================
// MODULE: 09_app_config.rules
// ==========================================
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }


// ==========================================
// MODULE: 09_settings.rules
// ==========================================
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }


// ==========================================
// MODULE: 10_taxi.rules
// ==========================================
    // Правила для Такси
    match /taxi_rides/{rideId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.driverId == request.auth.uid 
        && request.resource.data.keys().hasAll(['driverId', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == 'active';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.driverId ||
        ('passengerId' in resource.data && request.auth.uid == resource.data.passengerId) ||
        isAdmin()
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverId']));
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );
    }

    match /taxi_orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.passengerId == request.auth.uid 
        && request.resource.data.keys().hasAll(['passengerId', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == 'active';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId ||
        ('driverId' in resource.data && request.auth.uid == resource.data.driverId) ||
        isAdmin()
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['passengerId']));
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId ||
        isAdmin()
      );
    }

    match /taxi_bids/{bidId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid 
        && request.resource.data.keys().hasAll(['senderId', 'receiverId', 'targetId', 'offeredPrice', 'status'])
        && request.resource.data.offeredPrice is number
        && request.resource.data.offeredPrice >= 0
        && request.resource.data.status in ['pending', 'accepted', 'rejected'];
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'receiverId', 'targetId', 'offeredPrice']));
      allow delete: if false;
    }

    match /taxi_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.authorId == request.auth.uid 
        && request.resource.data.authorId != request.resource.data.targetUserId
        && request.resource.data.keys().hasAll(['authorId', 'targetUserId', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    match /taxi_history/{historyId} {
      allow create: if isSignedIn()
        && (request.resource.data.driverId == request.auth.uid || request.resource.data.passengerId == request.auth.uid);
      allow read: if isSignedIn()
        && (resource.data.driverId == request.auth.uid || resource.data.passengerId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn()
        && (resource.data.driverId == request.auth.uid || resource.data.passengerId == request.auth.uid || isAdmin());
    }


// ==========================================
// MODULE: 10b_offers.rules
// ==========================================
    // ─── OFFERS (предложения цены) ─────────────────────────────────────────
    // Источник истины по офферу. Статус решает сервер (respondToOffer,
    // functions/offers.js) — но функция сейчас не развёрнута (403 по
    // биллингу проекта), поэтому до её деплоя продавцу оставлена только
    // возможность зеркалить сюда отказ (см. правило update ниже), синхронно
    // с тем, что он делает в chats/{chatId}/messages/{messageId}
    // (04_chats.rules, правило #4). Переход в 'accepted' закрыт клиенту
    // ПОЛНОСТЬЮ и здесь, и там — именно Accept был источником прод-бага
    // (гонка + ложное "отклонено" по факту принятого предложения).
    match /offers/{offerId} {
      function offerData() {
        return request.resource.data;
      }

      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId ||
        isAdmin()
      );

      // Создать предложение может только покупатель и только за себя.
      // offerId жёстко детерминирован (adId_buyerId) — это и есть защита от
      // двух параллельных активных офферов на один товар.
      allow create: if isSignedIn() && !isBanned()
        && offerData().buyerId == request.auth.uid
        && offerId == offerData().adId + '_' + request.auth.uid
        && offerData().status == 'pending'
        && offerData().price is number
        && offerData().price > 0
        && offerData().adId is string
        && offerData().adId.size() > 0
        && offerData().sellerId is string
        && offerData().sellerId != request.auth.uid
        && exists(/databases/$(database)/documents/ads/$(offerData().adId))
        && offerData().sellerId == get(/databases/$(database)/documents/ads/$(offerData().adId)).data.userId
        && get(/databases/$(database)/documents/ads/$(offerData().adId)).data.status == 'active'
        && offerData().price >= get(/databases/$(database)/documents/ads/$(offerData().adId)).data.price * 0.7;

      // Покупатель может только перебить собственное предложение новой ценой
      // (pending → pending) либо отозвать его (pending → cancelled).
      allow update: if isSignedIn() && !isBanned()
        && request.auth.uid == resource.data.buyerId
        && offerData().buyerId == resource.data.buyerId
        && offerData().sellerId == resource.data.sellerId
        && offerData().adId == resource.data.adId
        && (
          (
            resource.data.status == 'pending'
            && offerData().status == 'cancelled'
            && offerData().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            offerData().status == 'pending'
            && offerData().price is number
            && offerData().price > 0
            && offerData().price >= get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.price * 0.7
            && get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.status == 'active'
          )
        );

      // Продавец — временно, до деплоя respondToOffer — может ТОЛЬКО
      // зеркалить сюда отказ, который он уже сделал в сообщении чата.
      // 'accepted' сюда попасть с клиента не может ни при каких условиях.
      allow update: if isSignedIn() && !isBanned()
        && request.auth.uid == resource.data.sellerId
        && resource.data.status == 'pending'
        && offerData().status == 'rejected'
        && offerData().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }


// ==========================================
// MODULE: 11_footer.rules
// ==========================================
  }
}


