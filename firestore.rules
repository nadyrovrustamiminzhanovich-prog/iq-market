rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId);
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || request.auth.token.admin == true);
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow create: if isSignedIn();
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        allow create: if isSignedIn() 
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users)
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.fromUserId);
    }
    
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if false; 
    }

    // Для Driver Verification (хоть такси и отложили, правила должны быть)
    match /driver_verifications/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false; 
    }
  }
}
