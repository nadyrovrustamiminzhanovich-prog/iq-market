rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Поддержка как Custom Claims, так и роли в документе
      return (request.auth.token.admin == true) || 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin');
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow delete: if isOwner(userId);
      // Пользователь может обновить свой телефон и галочку верификации
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'rating', 'reviewsCount', 'status'])));
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow create: if isSignedIn() 
        && request.resource.data.users.size() == 2 
        && (request.auth.uid in request.resource.data.users);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        allow create: if isSignedIn() 
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users)
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.fromUserId);
    }
    
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if false; 
    }

    // Правила для Telegram Auth Сессий (X10 Security)
    match /tg_auth_sessions/{sessionId} {
      allow create: if true; // Клиент создает токен сессии
      allow read: if true;   // Клиент слушает ответ от бота
      allow update, delete: if false; // Только Cloud Functions могут обновлять токен (OTP/CustomToken)
    }

    // Для Driver Verification (хоть такси и отложили, правила должны быть)
    match /driver_verifications/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false; 
    }

    // Правила для Такси (Сеньор-реализация)
    match /taxi_rides/{rideId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.driverId || isAdmin());
    }

    match /taxi_orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.passengerId || isAdmin());
    }

    match /taxi_bids/{bidId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow delete: if false;
    }

    match /taxi_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
    }
  }
}
