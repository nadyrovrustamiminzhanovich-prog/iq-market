// -------------------------------------------------------------
// AUTO-GENERATED FIRESTORE RULES - DO NOT EDIT THIS FILE DIRECTLY
// EDIT INDIVIDUAL MODULES IN "firestore_rules/" INSTEAD
// GENERATED AT: 2026-06-28T21:10:03.956144Z
// -------------------------------------------------------------

// ==========================================
// MODULE: 00_header.rules
// ==========================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


// ==========================================
// MODULE: 01_helpers.rules
// ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Поддержка как Custom Claims, так и роли в документе
      return ('admin' in request.auth.token && request.auth.token.admin == true) || 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin');
    }


// ==========================================
// MODULE: 02_users.rules
// ==========================================
    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId && (!request.resource.data.keys().hasAny(['accountType']) || request.resource.data.accountType in ['user', 'driver']);
      allow delete: if isOwner(userId);
      // Пользователь может обновить свой профиль, но не может изменить роль/рейтинг
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'rating', 'reviewsCount', 'status'])));

      // Уведомления: любой авторизованный может создать (отправить уведомление другому),
      // но читать и удалять — только сам владелец.
      match /notifications/{notifId} {
        allow create: if isSignedIn() && request.resource.data.keys().hasAll(['title', 'body', 'type', 'timestamp']);
        allow read, delete: if isOwner(userId);
        allow update: if isSignedIn() && (
          isOwner(userId) || 
          (resource.data.type == 'chat' && request.resource.data.type == 'chat' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type']))
        );
      }
    }


// ==========================================
// MODULE: 03_ads.rules
// ==========================================
    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'userId', 'timestamp'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if isSignedIn()
        && (isOwner(resource.data.userId) || isAdmin())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']));
      allow delete: if isSignedIn()
        && (isOwner(resource.data.userId) || isAdmin());
    }


// ==========================================
// MODULE: 04_chats.rules
// ==========================================
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users;
      allow delete: if false; 
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow create: if isSignedIn() && (request.resource.data.senderId == request.auth.uid) && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users) && (
          (request.auth.uid == resource.data.senderId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'timestamp', 'type'])) || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
        );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }


// ==========================================
// MODULE: 05_reviews.rules
// ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.fromUserId == request.auth.uid 
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn() && isOwner(resource.data.fromUserId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromUserId', 'toUserId']));
      allow delete: if isSignedIn() && isOwner(resource.data.fromUserId);
    }


// ==========================================
// MODULE: 06_reports.rules
// ==========================================
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUserId == request.auth.uid;
      allow read, delete: if isSignedIn() && isAdmin();
    }


// ==========================================
// MODULE: 07_sessions.rules
// ==========================================
    // Правила для Telegram Auth Сессий (X10 Security)
    match /tg_auth_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['created_at', 'verified', 'chat_id', 'otp', 'phone', 'customToken']) && request.resource.data.verified == false && request.resource.data.otp == null;
      allow get: if true; 
      allow list: if false; 
      allow update, delete: if false; 
    }


// ==========================================
// MODULE: 08_verifications.rules
// ==========================================
    // Для Driver Verification
    match /driver_verifications/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; 
    }


// ==========================================
// MODULE: 09_settings.rules
// ==========================================
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }


// ==========================================
// MODULE: 10_taxi.rules
// ==========================================
    // Правила для Такси
    match /taxi_rides/{rideId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.driverId == request.auth.uid 
        && request.resource.data.keys().hasAll(['driverId', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == 'active';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.driverId ||
        ('passengerId' in resource.data && request.auth.uid == resource.data.passengerId) ||
        isAdmin()
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverId']));
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.driverId ||
        isAdmin()
      );
    }

    match /taxi_orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.passengerId == request.auth.uid 
        && request.resource.data.keys().hasAll(['passengerId', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == 'active';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId ||
        ('driverId' in resource.data && request.auth.uid == resource.data.driverId) ||
        isAdmin()
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['passengerId']));
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId ||
        isAdmin()
      );
    }

    match /taxi_bids/{bidId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid 
        && request.resource.data.keys().hasAll(['senderId', 'receiverId', 'targetId', 'offeredPrice', 'status'])
        && request.resource.data.offeredPrice is number
        && request.resource.data.offeredPrice >= 0
        && request.resource.data.status in ['pending', 'accepted', 'rejected'];
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'receiverId', 'targetId']));
      allow delete: if false;
    }

    match /taxi_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.authorId == request.auth.uid 
        && request.resource.data.authorId != request.resource.data.targetUserId
        && request.resource.data.keys().hasAll(['authorId', 'targetUserId', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
    }


// ==========================================
// MODULE: 11_footer.rules
// ==========================================
  }
}


