    function isValidAdDescription() {
      // .size() считает UTF-8 байты, не символы (кириллица/уйгурский — по 2
      // байта на символ) — лимит в приложении 2000 символов
      // (post_ad_screen.dart), здесь запас x4, это серверный рубеж от
      // абьюза в обход клиента, а не копия клиентского лимита.
      return !request.resource.data.keys().hasAny(['description'])
        || (request.resource.data.description is string && request.resource.data.description.size() <= 8000);
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'userId', 'timestamp'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && isValidAdDescription();
      allow update: if isSignedIn()
        && isValidAdDescription()
        && (
          isAdmin() || (
            isOwner(resource.data.userId)
            // Бан блокировал только create — забаненный владелец мог по-прежнему
            // редактировать/переиздавать/архивировать уже существующие объявления.
            && !isBanned()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'views', 'favorites', 'timestamp'])
            // expiresAt/notifiedExpiry разрешено менять ТОЛЬКО отдельным вызовом
            // "Продлить"/реактивации (extendAd/toggleAdStatus — никогда не трогают
            // контентные поля), не вместе с обычной правкой контента. Без этого
            // условия обычное редактирование объявления бесплатно сбрасывало 30-
            // дневный таймер при каждом сохранении, полностью в обход суточного
            // лимита публикаций (checkAdRateLimit проверяется только при СОЗДАНИИ).
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['expiresAt', 'notifiedExpiry'])
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'price', 'category', 'images', 'video_url', 'videoDurationSeconds', 'location', 'condition', 'extraFields'])
            )
            // 'pending' обязан быть в списке: ad_service.dart переиздаёт
            // РЕДАКТИРОВАНИЕ существующего объявления через update(), а не
            // create() (create ничего не проверяет по status — им пишутся
            // только новые объявления). Без 'pending' здесь повторная
            // публикация объявления, отклонённого админом, ловила
            // permission-denied вместо ухода на повторную ручную проверку —
            // тот же класс ошибки, что и на дубликат-проверке при
            // редактировании (checkAdFingerprint -> MANUAL_REVIEW).
            // 'rejected' сюда НЕ добавлять: сам себя отклонять
            // владельцу незачем, это решение остаётся только за isAdmin().
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['active', 'reserved', 'sold', 'archived', 'pending'])
          )
        );
      allow delete: if isSignedIn()
        && (isOwner(resource.data.userId) || isAdmin());

      match /stats/counters {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /viewLogs/{logId} {
      allow read, write: if false;
    }
