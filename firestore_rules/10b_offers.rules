    // ─── OFFERS (предложения цены) ─────────────────────────────────────────
    // Источник истины по офферу. Статус решает сервер (respondToOffer,
    // functions/offers.js) — но функция сейчас не развёрнута (403 по
    // биллингу проекта), поэтому до её деплоя продавцу оставлена только
    // возможность зеркалить сюда отказ (см. правило update ниже), синхронно
    // с тем, что он делает в chats/{chatId}/messages/{messageId}
    // (04_chats.rules, правило #4). Переход в 'accepted' закрыт клиенту
    // ПОЛНОСТЬЮ и здесь, и там — именно Accept был источником прод-бага
    // (гонка + ложное "отклонено" по факту принятого предложения).
    match /offers/{offerId} {
      function offerData() {
        return request.resource.data;
      }

      // Свой слот оффера — тот, чей id заканчивается на uid читающего
      // (offerId детерминирован: adId + '_' + buyerId). Суффикс, а не split
      // по '_': uid телеграм-аккаунтов сам содержит подчёркивание.
      function isOwnOfferSlot(oid) {
        return oid.size() > request.auth.uid.size()
          && oid[oid.size() - request.auth.uid.size() : oid.size()] == request.auth.uid;
      }

      // `resource == null` (документа нет) обязателен ПЕРВЫМ условием: при
      // чтении несуществующего документа resource равен null, и обращение к
      // resource.data.buyerId — не false, а ошибка вычисления, то есть
      // permission-denied. На это падало КАЖДОЕ первое предложение цены по
      // товару: ChatService.sendOffer читает свой слот оффера, чтобы погасить
      // прошлую карточку, и получал отказ ещё до записи.
      // Пустой слот виден только его владельцу — чужие offerId остаются
      // неразличимы (deny и на существующем, и на отсутствующем).
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource == null && isOwnOfferSlot(offerId)) ||
        (resource != null && (
          request.auth.uid == resource.data.buyerId ||
          request.auth.uid == resource.data.sellerId
        ))
      );

      // Создать предложение может только покупатель и только за себя.
      // offerId жёстко детерминирован (adId_buyerId) — это и есть защита от
      // двух параллельных активных офферов на один товар.
      allow create: if isSignedIn() && !isBanned()
        && offerData().buyerId == request.auth.uid
        && offerId == offerData().adId + '_' + request.auth.uid
        && offerData().status == 'pending'
        && offerData().price is number
        && offerData().price > 0
        && offerData().adId is string
        && offerData().adId.size() > 0
        && offerData().sellerId is string
        && offerData().sellerId != request.auth.uid
        && exists(/databases/$(database)/documents/ads/$(offerData().adId))
        && offerData().sellerId == get(/databases/$(database)/documents/ads/$(offerData().adId)).data.userId
        && get(/databases/$(database)/documents/ads/$(offerData().adId)).data.status == 'active'
        && offerData().price >= get(/databases/$(database)/documents/ads/$(offerData().adId)).data.price * 0.7;

      // Покупатель может только перебить собственное предложение новой ценой
      // (pending → pending) либо отозвать его (pending → cancelled).
      allow update: if isSignedIn() && !isBanned()
        && request.auth.uid == resource.data.buyerId
        && offerData().buyerId == resource.data.buyerId
        && offerData().sellerId == resource.data.sellerId
        && offerData().adId == resource.data.adId
        && (
          (
            resource.data.status == 'pending'
            && offerData().status == 'cancelled'
            && offerData().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            offerData().status == 'pending'
            && offerData().price is number
            && offerData().price > 0
            && offerData().price >= get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.price * 0.7
            && get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.status == 'active'
          )
        );

      // У ПРОДАВЦА ПРАВА НА ЗАПИСЬ ЗДЕСЬ НЕТ НАМЕРЕННО.
      // Ответ на предложение (и accept, и reject) исполняет только сервер —
      // Cloud Function respondToOffer через Admin SDK, которому правила не
      // применяются. Он один умеет то, что клиент не умеет в принципе:
      // атомарно разрешить гонку двух одновременных Accept и отклонить
      // конкурирующие офферы на тот же товар (запрос по offers.adId —
      // через чаты это невозможно, chatId не привязан к объявлению).
      //
      // Раньше здесь стояло временное правило «продавец может pending →
      // rejected» — заплатка на период, пока respondToOffer не была
      // развёрнута из-за блокировки биллинга. Функция развёрнута, заплатка
      // убрана. Не возвращать: любой клиентский переход статуса открывает
      // заново тот же прод-баг.

      allow delete: if false;
    }
