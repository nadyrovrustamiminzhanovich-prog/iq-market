    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin()) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['users']) ||
        request.resource.data.users.toSet() == resource.data.users.toSet()
      );
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && !isBlockedByUsersList(request.resource.data.users);
      allow delete: if false; 
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users || isAdmin());

        // ─── CREATE ────────────────────────────────────────────────────────────
        allow create: if isSignedIn()
          && !isBanned()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
          && !isBlockedInChat(chatId)
          // Системные сообщения ("Предложение принято/отклонено") пишет только
          // сервер — иначе покупателю можно подсунуть фальшивое подтверждение.
          && request.resource.data.type != 'system'
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000)
          && (
            request.resource.data.type != 'offer'
            ||
            (
              request.resource.data.type == 'offer'
              && request.resource.data.offerPrice is number
              && request.resource.data.offerPrice > 0
              && request.resource.data.adId is string
              && request.resource.data.adId.size() > 0
              && request.auth.uid != get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.userId
              && request.resource.data.offerPrice >= get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.price * 0.7
              && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.status == 'active'
            )
          );

        // ─── UPDATE ────────────────────────────────────────────────────────────
        allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users) && (
          // 1. Sender editing own NON-OFFER messages.
          //    'deletedFor' исключён намеренно: единственный путь к нему —
          //    правило #4, где проверяется, что участник добавляет ровно свой
          //    uid. Иначе автор мог бы прописать туда чужой uid и решать за
          //    собеседника, что тому видно.
          //
          //    'isRead'/'isDelivered'/'readAt' исключены по той же логике:
          //    статус доставки и прочтения проставляет ТОЛЬКО получатель
          //    (правило #3). Пока эти ключи были открыты автору, клиент мог
          //    пометить собственное сообщение прочитанным — и отправитель
          //    видел 2 синие галочки сразу после отправки, хотя собеседник
          //    даже не заходил в приложение. Легитимных правок этих полей у
          //    автора нет: он пишет их только при create.
          //
          //    `get('type', 'text')`, а не `resource.data.type`: у сообщений,
          //    записанных до появления поля type, обращение к нему — не false,
          //    а ошибка вычисления правила, которая рубит ВСЮ ветку. На таких
          //    документах автор не мог даже дописать mediaUrl после загрузки
          //    фото (вечный спиннер без единого шанса на повтор).
          (
            request.auth.uid == resource.data.senderId
            // Бан блокировал только create нового сообщения — забаненный
            // отправитель мог по-прежнему редактировать уже отправленные
            // (например, дописать mediaUrl/текст). Остальные 3 ветки update
            // (отмена своего оффера, чужие read-receipt, «удалить у меня»)
            // сознательно НЕ гейтятся банном — это не публикация контента.
            && !isBanned()
            && resource.data.get('type', 'text') != 'offer'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'timestamp', 'type', 'deletedFor', 'isRead', 'isDelivered', 'readAt'])
          ) ||
          // 2. Sender cancelling own PENDING OFFER message (deduplication)
          (
            request.auth.uid == resource.data.senderId
            && resource.data.type == 'offer'
            && resource.data.offerStatus == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerStatus'])
            && request.resource.data.offerStatus == 'cancelled'
          ) ||
          // 3. Only the recipient (not the sender) marking messages as read/delivered
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'isDelivered', 'readAt'])
            && request.auth.uid != resource.data.senderId
          ) ||
          // ── ОТВЕТ НА ОФФЕР ЗДЕСЬ ОТСУТСТВУЕТ НАМЕРЕННО ───────────────────
          // Ни 'accepted', ни 'rejected' продавцу с клиента недоступны.
          // Ответ на предложение целиком исполняет сервер (Cloud Function
          // respondToOffer, functions/offers.js) через Admin SDK, которому
          // правила не применяются: он атомарно меняет offers/{offerId},
          // зеркалит статус в это сообщение, пишет системное сообщение и
          // отклоняет конкурентов на тот же товар.
          //
          // Не возвращать сюда правило вида «продавец может выставить
          // offerStatus»: именно клиентский переход статуса был источником
          // прод-бага (гонка двух Accept + ложное «отклонено» по факту
          // принятого предложения). Пока этого правила нет, класс бага
          // физически невозможен.
          //
          // 4. «Удалить у меня» — персональное скрытие сообщения.
          //    Документ сообщения один на двоих, физически удалить его может
          //    только автор (см. allow delete ниже). Поэтому для получателя
          //    единственный корректный вариант — пометка deletedFor, которую
          //    клиент фильтрует на чтении.
          //
          //    Инвариант жёсткий: итоговый deletedFor обязан быть точно
          //    "старый ∪ {мой uid}". Это разом запрещает и добавить чужой uid
          //    (скрыть сообщение у собеседника), и убрать чужую пометку
          //    (вернуть ему то, что он у себя удалил). Повторное скрытие
          //    уже скрытого проходит — множество не меняется.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            && request.resource.data.deletedFor is list
            && request.resource.data.deletedFor.toSet() == resource.data.get('deletedFor', []).toSet().union([request.auth.uid].toSet())
          )
        );

        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }
