    function isValidReportComment() {
      // .size() считает UTF-8 байты, не символы — лимит в приложении 300
      // символов (report_ad_sheet.dart/report_user_sheet.dart), здесь запас
      // x4, это серверный рубеж от абьюза в обход клиента.
      return !request.resource.data.keys().hasAny(['comment'])
        || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1200);
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource == null || resource.data.reporterUserId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      // Анонимная ветка убрана: UI (report_ad_sheet.dart/report_user_sheet.dart)
      // всегда показывает auth-гейт перед открытием шторки жалобы — 'anonymous'
      // в reporterUserId/userId там только defensive-фолбэк на случай null
      // currentUser, который на практике недостижим. Правило было шире, чем
      // нужно реальному клиенту.
      allow create: if isSignedIn() && (request.resource.data.reporterUserId == request.auth.uid || request.resource.data.userId == request.auth.uid)
        && isValidReportComment();
      allow update, delete: if isSignedIn() && isAdmin();
    }
