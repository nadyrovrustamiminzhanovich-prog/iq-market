    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['phone', 'email', 'telegram_chat_id', 'telegramChatId'])
        && (!request.resource.data.keys().hasAny(['accountType']) || request.resource.data.accountType in ['user', 'driver'])
        // 🔒 rating/reviewsCount на создании — без этого модифицированный
        // клиент мог родить аккаунт сразу с накрученной репутацией
        // (например rating: 4.9, reviewsCount: 500). Разрешены только
        // стартовые значения, которыми UserService.syncUserAfterLogin и так
        // всегда создаёт новый профиль (rating: 5.0, reviewsCount: 0).
        && (!request.resource.data.keys().hasAny(['rating']) || request.resource.data.rating == 5.0)
        && (!request.resource.data.keys().hasAny(['reviewsCount']) || request.resource.data.reviewsCount == 0)
        && (!request.resource.data.keys().hasAny(['isVerified']) || request.resource.data.isVerified == false || (request.auth.uid.size() >= 9 && request.auth.uid[0:9] == 'telegram_'))
        // 🔒 isTelegramVerified/verified_phone на создании — тот же принцип, что
        // и isVerified выше: без этого ЛЮБОЙ новый аккаунт мог сразу родиться
        // "телеграм-подтверждённым" с произвольным чужим номером в
        // verified_phone (см. подробное объяснение векторов атаки у allow update).
        && (!request.resource.data.keys().hasAny(['isTelegramVerified', 'verified_phone']) || (request.auth.uid.size() >= 9 && request.auth.uid[0:9] == 'telegram_'));
      allow delete: if isOwner(userId);
      // Пользователь может обновить свой профиль (в т.ч. driverOnboardingStep в диапазоне 0..3), но не может изменить роль/рейтинг/верификацию/контакты
      allow update: if isAdmin() || (isOwner(userId)
        && !request.resource.data.keys().hasAny(['phone', 'email', 'telegram_chat_id', 'telegramChatId'])
        && (!request.resource.data.keys().hasAny(['driverOnboardingStep']) || (request.resource.data.driverOnboardingStep is int && request.resource.data.driverOnboardingStep >= 0 && request.resource.data.driverOnboardingStep <= 3))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'rating', 'reviewsCount', 'status', 'duplicateStrikeCount', 'postingRestricted', 'postingRestrictedAt']))
        // 🔒 isVerified/isTelegramVerified/verified_phone — раньше isVerified был
        // тут же безусловно запрещён, а isTelegramVerified/verified_phone вообще
        // ничем не были защищены: любой авторизованный пользователь (в т.ч.
        // обычный email/Google-аккаунт) мог сам выставить себе "телеграм
        // подтверждён" (обход OTP-верификации водителя такси) и подставить
        // ЧУЖОЙ реальный номер телефона, который потом виден в контактах
        // объявления — вектор докса. Изменение этих 3 полей разрешено ТОЛЬКО
        // аккаунтам с uid вида telegram_* — такой uid минтит исключительно
        // доверенная Cloud Function verifyTelegramOtp после реальной проверки
        // OTP в боте (см. functions/telegram_bot.js), подделать его нельзя.
        // Это тот самый путь, которым UserService.markPhoneVerifiedViaTelegram
        // легитимно дописывает verified_phone/isTelegramVerified сразу после
        // входа через Телеграм (login_screen.dart _finalizeLogin) — единственный
        // случай, где сервер САМ не пишет эти поля (аккаунта ещё не было в
        // момент вызова verifyTelegramOtp, писать было некуда). Для уже
        // существующих аккаунтов (профиль/водитель линкуют Телеграм через
        // telegram_verification_dialog.dart / driver_onboarding_wizard.dart)
        // сервер САМ проставляет эти поля через Admin SDK — клиент их больше
        // не дублирует.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isTelegramVerified', 'verified_phone']) || (request.auth.uid.size() >= 9 && request.auth.uid[0:9] == 'telegram_')));

      match /private/contact {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow create: if isSignedIn() && (
          isOwner(userId) ||
          isAdmin() ||
          (
            request.resource.data.keys().hasAll(['title', 'body', 'type', 'timestamp', 'senderId']) &&
            request.resource.data.senderId == request.auth.uid &&
            notifId.size() > 5 && 
            notifId[0:5] == 'chat_' && 
            get(/databases/$(database)/documents/chats/$(notifId[5:])).data.users.hasAll([request.auth.uid, userId])
          )
        );
        allow read, delete: if isOwner(userId);
        allow update: if isSignedIn() && (
          isOwner(userId) ||
          // Ветка «любой авторизованный может менять isRead в ЧУЖОМ уведомлении»
          // убрана намеренно: она разрешала посторонним гасить (и возвращать)
          // счётчик уведомлений другого пользователя, зная только его uid и id
          // документа. Владельцу это и так разрешено первой веткой —
          // NotificationService.markAsRead/markAllAsRead и ChatService.markAsRead
          // ходят только в свою коллекцию.
          (
            // Разрешаем отправителю обновлять chat-notification (upsert паттерн)
            // Те же проверки что и в create — senderId, формат notifId, участие в чате
            request.resource.data.keys().hasAll(['title', 'body', 'type', 'timestamp', 'senderId']) &&
            request.resource.data.senderId == request.auth.uid &&
            notifId.size() > 5 &&
            notifId[0:5] == 'chat_' &&
            get(/databases/$(database)/documents/chats/$(notifId[5:])).data.users.hasAll([request.auth.uid, userId]) &&
            // Отправитель НЕ имеет права пометить уведомление прочитанным:
            // иначе он гасит колокольчик получателю, и тот не узнает о
            // сообщении. Ставить isRead: false ему можно — именно это делает
            // upsert нового сообщения, поднимая уведомление обратно в
            // непрочитанные. Проверка через diff, а не «isRead == false»:
            // обезличивание удалённого сообщения (_neutralizeChatNotification)
            // приходит merge'ем без этого ключа и обязано проходить даже по
            // уже прочитанному уведомлению.
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isRead']) ||
              request.resource.data.isRead == false
            )
          )
        );
      }
    }
