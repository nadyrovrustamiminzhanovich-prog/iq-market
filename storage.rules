rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Вспомогательная функция
    function isSignedIn() {
      return request.auth != null;
    }

    // Медиафайлы объявлений (ads/images, ads/videos)
    match /ads/{allPaths=**} {
      allow read: if true; // Читать могут все
      allow write: if isSignedIn() 
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*'); // Только медиа
    }

    // Медиафайлы чатов (chats/...)
    match /chats/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() 
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
    }

    // Аватарки и личные файлы (папки с UID пользователя)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Резервное правило для остальных загрузок
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false; // 🔒 Запрет на запись вне определенных папок
    }
  }
}
