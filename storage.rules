rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Вспомогательные функции
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return ('admin' in request.auth.token && request.auth.token.admin == true) || 
             (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)) != null && 
              'accountType' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data && 
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountType == 'admin');
    }

    function isChatParticipant(chatId) {
      return request.auth != null && (
        chatId.matches('^' + request.auth.uid + '_.*') ||
        chatId.matches('.*_' + request.auth.uid + '$') ||
        (firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
         'users' in firestore.get(/databases/(default)/documents/chats/$(chatId)).data &&
         request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.users)
      );
    }

    // Медиафайлы объявлений (ads/{uid}/images, ads/{uid}/videos)
    match /ads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                   && (request.resource == null || (request.resource.size < 50 * 1024 * 1024 && request.resource.contentType.matches('image/.*|video/.*')));
    }



    // Личные голосовые сообщения вне chats
    // 🔒 contentType обязателен: без него можно было залить файл любого типа
    // под видом голосового (клиент всегда шлёт .m4a → audio/mp4, см. file_service.dart).
    match /voice_messages/{chatId}/{allPaths=**} {
      allow read: if isSignedIn() && (isChatParticipant(chatId) || isAdmin());
      allow write: if isSignedIn() && isChatParticipant(chatId)
                   && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('audio/.*')));
    }

    // Чат медиа (если сохраняются вне chats)
    // 🔒 contentType обязателен: клиент шлёт сюда только фото (.jpg → image/jpeg,
    // chat_screen.dart _uploadImageWithRetry), видео в чате не отправляются.
    match /chat_media/{chatId}/{allPaths=**} {
      allow read: if isSignedIn() && (isChatParticipant(chatId) || isAdmin());
      allow write: if isSignedIn() && isChatParticipant(chatId)
                   && (request.resource == null || (request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Верификационные документы водителя
    match /driver_documents/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Аватарки и личные файлы (папки с UID пользователя)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Вложения чатов (chats)
    match /chats/{chatId}/{allPaths=**} {
      allow read: if isSignedIn() && (isChatParticipant(chatId) || isAdmin());
      allow write: if isSignedIn() && isChatParticipant(chatId)
                    && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }

    // Фото к отзывам (reviews/{uid}/...)
    match /reviews/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                   && (request.resource == null || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Резервное правило для остальных загрузок
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false; // 🔒 Запрет на запись/чтение вне определенных папок
    }
  }
}
